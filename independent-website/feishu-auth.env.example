# Copy the needed values into your shell environment before starting
# feishu_auth_server.py. Do not commit real secrets.

FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: load app_id/app_secret from a local JSON config instead of exporting
# the secret directly. Keep this file outside the public repository.
# FEISHU_CREDENTIALS_FILE=/Users/dianchi/DC-Agent/data/cmd_config.json
# FEISHU_CREDENTIALS_APP_ID=cli_xxxxxxxxxxxxx

# Must match the redirect URL configured in the Feishu developer console:
# 开发配置 -> 安全设置 -> 重定向 URL
FEISHU_REDIRECT_URI=https://your-domain.example.com/auth/feishu/callback

# Optional. Keep the default minimal profile scope unless more user fields are needed.
FEISHU_OAUTH_SCOPE=contact:user.base:readonly

# Required in production so session cookies remain valid across restarts.
SITE_SESSION_SECRET=change-this-to-a-long-random-string

DC_HOMEPAGE_HOST=127.0.0.1
DC_HOMEPAGE_PORT=8032
